<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MS600: 需要写 Settings.Global（投屏开关/状态，供「设备设置」读写）。
         该权限是 signature|privileged 级，platform 签名即可获得。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- MS600: NETWORK_SETTINGS（signature 级）—— WifiPermissionsUtil 对持有它的 UID
         直接放行位置检查。本机无 GPS 硬件，缺此权限时 createGroup / 服务发现会因
         "UID x has no location permission" 失败；它同时是 setDeviceName 所需。 -->
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />

    <!-- MS600: CONFIGURE_WIFI_DISPLAY（signature 级）—— setWFDInfo 必需。
         platform 签名 + 本声明即可自动获得；缺它时 setWFDInfo 抛
         "SecurityException: Wifi Display Permission denied for uid"。 -->
    <uses-permission android:name="android.permission.CONFIGURE_WIFI_DISPLAY" />

    <!-- MS600: LOCATION_HARDWARE（signature|privileged）—— 部分扫描路径要求 -->
    <uses-permission android:name="android.permission.LOCATION_HARDWARE" />

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Wi-Fi Direct 需要定位权限。Android 12+ 只申请 FINE 会被系统拒绝，必须同时声明 COARSE。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Wi-Fi Direct / Miracast 发现 -->
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 开机自启时用 connectedDevice 类型，Android 15 起 BOOT_COMPLETED 不允许启动 mediaPlayback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- 开机自动启动接收服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 后台拉起播放页：Android 10+ 禁止后台启动 Activity，只有前台服务不够，
         持有「显示在其他应用上层」权限的应用可豁免，否则应用不在前台时投屏没有画面 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- TV 特性声明 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- MS600: 供「设备设置」启动/停止接收服务（signature 级，platform 签名可用） -->
    <permission
        android:name="com.iflytek.ms600.cast.permission.CONTROL"
        android:protectionLevel="signature" />

    <application
        android:name=".MiracastApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MS600Cast"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 主 Activity - TV Launcher 入口 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.MS600Cast">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- 投屏播放 Activity -->
        <activity
            android:name=".ui.PlayerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.MS600Cast.Fullscreen" />

        <!-- 连接确认 Activity -->
        <activity
            android:name=".ui.ConnectActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MS600Cast.Dialog" />

        <!-- 投屏接收服务。MS600: 导出以便「设备设置」直接启停，
             用 signature 级自定义权限保护（仅 platform 签名应用可调用）。 -->
        <service
            android:name=".service.CastReceiverService"
            android:enabled="true"
            android:exported="true"
            android:permission="com.iflytek.ms600.cast.permission.CONTROL"
            android:foregroundServiceType="mediaPlayback|connectedDevice" />

        <!-- MS600: 已移除 BootReceiver —— 不打开应用时完全不自启、不占用系统资源 -->
    
        <!-- MS600_PATCH_20261027_TILE 控制中心磁贴：打开投屏界面 -->
        <service
            android:name=".CastTileService"
            android:label="@string/tile_cast_label"
            android:icon="@drawable/ic_stat_miracast"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
</application>

</manifest>
