    <string name="adb_rules_sum_custom">%1$d custom keywords</string>
    <string name="adb_rules_dlg_title">Block keywords (%1$d)</string>
    <string name="adb_rules_help">One keyword per line, a domain fragment is enough (e.g. doubleclick).\n\nThe first 256 bytes of every connection are scanned: HTTP uses the Host header, HTTPS uses the server name in the TLS handshake (SNI is plaintext before encryption). A match drops the connection.\n\nTakes effect in about 3 seconds, no reboot needed. Only letters, digits, dot, dash and underscore are accepted.</string>
