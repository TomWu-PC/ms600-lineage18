# MS600 v163: exFAT OTG 自动挂载（userspace FUSE）
#
# 背景：内核没编 CONFIG_EXFAT_FS，vold 因此拒绝挂载 exFAT 分区。
# 这里用 mount.exfat（libfuse 2.9.9 + exfat-fuse 1.3.0 静态交叉编译）接管：
#   插入 exFAT 分区 -> 自动挂到 /mnt/exfat/<卷标>
#   拔出           -> 自动卸载并清理挂载点
#
# ⚠️ 挂载点普通 App 不可见（Android 11 FUSE 隔离），需 root 文件管理器访问。
#
# v163 之前这套东西是 Magisk 模块（/data/adb/modules/exfat_otg），
# 清数据/卸载 Magisk 就会丢。现在做进 system，永久生效。

on boot
    chmod 0755 /system/bin/mount.exfat
    chmod 0755 /system/etc/exfat_daemon.sh

service ms600_exfat /system/bin/sh /system/etc/exfat_daemon.sh
    class late_start
    user root
    group root system
    disabled

# 等系统真正起来（vold/存储服务就绪）再拉守护
on property:sys.boot_completed=1
    start ms600_exfat
