# MS600 A11 ueventd 规则（2026-10-04 v66）
# ============================================================================
# 原厂 8.1 的 ueventd.qcom.rc 未随 porting 带过来 ⇒ 大量设备节点保持内核默认
# 0600 root:root，导致依赖它们的服务全部失败：
#   - gatekeeper  : 打不开 /dev/qseecom   → QSEECom_start_app failed → SIGABRT 循环
#   - 蓝牙        : 打不开 /dev/btpower   → native crash
#   - WiFi        : /dev/wcnss_wlan /dev/wcnss_ctrl /dev/wlan
#   - 音频/相机/电话: 一批 msm_* / radio 节点
# 规则取自原厂 vendor 分区 ueventd.rc（/data/local/tmp/stockv/ueventd.rc），
# 非标准组 oem_2901 统一替换为标准组 system。
# A11 ueventd 解析路径: /system/etc/ueventd.rc /vendor/ueventd.rc /odm/ueventd.rc /ueventd.<ro.hardware>.rc
# ============================================================================

# --- 图形（原有，保留）---
/dev/kgsl-3d0           0666   system   graphics
/dev/kgsl-2d0           0666   system   graphics
/dev/kgsl-2d1           0666   system   graphics
/dev/kgsl               0666   system   graphics
/dev/ion                0666   system   graphics
/dev/dri/*              0666   system   graphics
/dev/graphics/*         0666   system   graphics
/dev/mdss_rotator       0666   system   graphics
/dev/msm_rotator        0660   system   system

# --- TEE / 锁屏 gatekeeper / keymaster ---
/dev/qseecom            0660   system   drmrpc
/dev/qsee_ipc_irq_spss  0660   system   drmrpc
/dev/smcinvoke          0660   system   system
/dev/sp_keymaster       0660   system   system
/dev/spcom              0660   system   system
/dev/sp_kernel          0660   system   system
/dev/sp_ssr             0660   system   system
/dev/cryptoapp          0660   system   system
/dev/pft                0660   system   drmrpc
/dev/seemplog           0660   system   system

# --- WiFi / WCNSS ---
/dev/wlan               0660   wifi     wifi
/dev/wcnss_wlan         0660   system   system
/dev/wcnss_ctrl         0660   system   system

# --- 蓝牙 ---
/dev/btpower            0660   bluetooth system
/dev/smd2               0660   bluetooth bluetooth
/dev/smd3               0660   bluetooth bluetooth
/dev/smd7               0660   bluetooth bluetooth
/dev/rfcomm0            0660   bluetooth bluetooth
/dev/ttyUSB0            0660   bluetooth bluetooth

# --- 音频 / DSP ---
/dev/adsprpc-smd        0664   system   system
/dev/sdsprpc-smd        0660   system   system
/dev/spidev0.0          0660   system   audio
/dev/wcd_dsp0_control   0660   system   audio
/dev/wcd-dsp-glink      0660   system   audio
/dev/audio_slimslave    0660   system   audio
/dev/msm_audio_cal      0660   system   audio
/dev/msm_hweffects      0660   system   audio
/dev/msm_pcm_*          0660   system   audio
/dev/msm_multi_aac      0660   system   audio
/dev/msm_aac*           0660   system   audio
/dev/msm_vidc_reg       0660   system   audio
/dev/msm_vidc_dec       0660   system   audio
/dev/msm_vidc_dec_sec   0660   system   audio
/dev/msm_vidc_enc       0660   system   audio

# --- 相机 ---
/dev/video*             0660   system   camera
/dev/media*             0660   system   camera
/dev/v4l-subdev*        0660   system   camera
/dev/msm_camera/*       0660   system   camera
/dev/gemini0            0660   system   camera
/dev/gemini/*           0660   system   camera
/dev/mercury0           0660   system   camera
/dev/jpeg0              0660   system   camera
/dev/jpeg1              0660   system   camera
/dev/jpeg2              0660   system   camera
/dev/jpeg3              0660   system   camera

# --- 电话 / 基带 ---
/dev/diag               0660   system   system
/dev/smd0               0660   system   system
/dev/smd4               0660   system   system
/dev/smd5               0660   system   system
/dev/smd6               0660   system   system
/dev/smd11              0660   radio    radio
/dev/smd_cxm_qmi        0640   radio    radio
/dev/ipa                0660   radio    radio
/dev/wwan_ioctl         0660   radio    radio
/dev/ipaNatTable        0660   radio    radio
/dev/radio0             0640   system   system
/dev/smdcntl*           0640   radio    radio
/dev/smdcnt_rev*        0640   radio    radio
/dev/smuxctl*           0640   radio    radio
/dev/sdioctl*           0640   radio    radio
/dev/rmnet_mux_ctrl     0640   radio    radio
/dev/hsicctl*           0640   radio    radio
/dev/mhi_pipe_*         0640   radio    radio
/dev/system_health_monitor 0644 radio system
/dev/rtc0               0660   system   system
